{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ektel.local/contracts/schemas/v1/execution-result.schema.json",
  "title": "EktelExecutionResult v1",
  "description": "Resultado post-inicio (spec v1.2 §8.3; propuesta §7.5). Sólo cuatro estados; budget_exceeded no existe en v1. executed no significa éxito de negocio. Clasificación por causa (C6): cause_code cerrado. Corrección H3: unión discriminada por state mediante if/then — cada estado exige cause_code compatible y evidencia suficiente y obtenible; supervision_failed no exige tiempos (rama propia: la evidencia puede no existir). discarded_bytes SIEMPRE presente (0 cuando no hubo truncación — decisión documentada en el acta §11). Semántica de pattern: Draft 2020-12, coincidencia NO anclada; los patrones van auto-anclados (^ y fin absoluto (?![\\s\\S])) y rechazan prefijos, sufijos y newline final por sí mismos (spec §5.7). Regla uniforme de schema_version (B8): entero > 1 → schema_version_unsupported; entero <= 0 y booleano → invalid_value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "identity_digest",
    "state",
    "artifact_identity_profile",
    "cause_code",
    "discarded_bytes",
    "guarantees_applied"
  ],
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "executed" } }, "required": ["state"] },
      "then": {
        "properties": { "cause_code": { "enum": ["natural_exit"] } },
        "required": ["started_at_wall", "finished_at_wall", "duration_monotonic_ms",
                     "stdout_truncation", "stderr_truncation"]
      }
    },
    {
      "if": { "properties": { "state": { "const": "deadline_exceeded" } }, "required": ["state"] },
      "then": {
        "properties": { "cause_code": { "enum": ["deadline_duration", "deadline_validity_exhausted"] } },
        "required": ["started_at_wall", "finished_at_wall", "duration_monotonic_ms",
                     "stdout_truncation", "stderr_truncation"]
      }
    },
    {
      "if": { "properties": { "state": { "const": "terminated" } }, "required": ["state"] },
      "then": {
        "properties": { "cause_code": { "enum": ["external_termination"] } },
        "required": ["started_at_wall", "finished_at_wall", "duration_monotonic_ms",
                     "stdout_truncation", "stderr_truncation"]
      }
    },
    {
      "if": { "properties": { "state": { "const": "supervision_failed" } }, "required": ["state"] },
      "then": {
        "properties": { "cause_code": { "enum": ["supervision_failure"] } }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "identity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "state": {
      "enum": [
        "executed",
        "deadline_exceeded",
        "terminated",
        "supervision_failed"
      ]
    },
    "artifact_identity_profile": {
      "const": "route_mutable_unverified"
    },
    "started_at_wall": {
      "type": "integer",
      "minimum": 0
    },
    "finished_at_wall": {
      "type": "integer",
      "minimum": 0
    },
    "duration_monotonic_ms": {
      "type": "integer",
      "minimum": 0
    },
    "exit_code_or_signal": {
      "type": "string"
    },
    "cause_code": {
      "enum": [
        "natural_exit",
        "deadline_duration",
        "deadline_validity_exhausted",
        "external_termination",
        "supervision_failure"
      ]
    },
    "validity_at_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nbf",
        "exp"
      ],
      "properties": {
        "nbf": {
          "type": "integer",
          "minimum": 0
        },
        "exp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "guarantees_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "magnitude",
          "class",
          "platform",
          "mechanism",
          "assumptions",
          "known_escapes",
          "failure_mode",
          "evidence_ref"
        ],
        "properties": {
          "magnitude": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "enforced",
              "reactive",
              "observed",
              "unsupported"
            ]
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 64
          },
          "known_escapes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 64
          },
          "failure_mode": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "stdout_truncation": {
      "type": "boolean"
    },
    "stderr_truncation": {
      "type": "boolean"
    },
    "discarded_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "last_event_receipt": {
      "type": "string"
    }
  }
}
